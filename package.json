{
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "db:generate": "drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=./src/db/drizzle.config.ts",
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "prepare": "husky",
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json --resolve-full-paths",
    "start": "node --trace-deprecation dist/src/index.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit && pnpm test:http",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:http": "tsx ./tests/http",
    "quality": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@better-auth/redis-storage": "^1.6.19",
    "@dotenvx/dotenvx": "^2.19.0",
    "@hono/node-server": "^1.19.11",
    "@scalar/hono-api-reference": "^0.11.3",
    "big.js": "^7.0.1",
    "bullmq": "^5.76.5",
    "camelcase": "^9.0.0",
    "chalk": "^5.6.2",
    "cockatiel": "^4.0.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "emoji-regex": "^10.6.0",
    "hono": "^4.13.1",
    "install": "^0.13.0",
    "ioredis": "^5.10.0",
    "jose": "^6.2.2",
    "lodash.camelcase": "^4.3.0",
    "lodash.defaultto": "^4.14.0",
    "lodash.has": "^4.5.2",
    "lodash.head": "^4.0.1",
    "lodash.isempty": "^4.4.0",
    "lodash.isundefined": "^3.0.1",
    "lodash.omitby": "^4.6.0",
    "mysql2": "^3.20.0",
    "nanoid": "3.3.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "posthog-node": "^5.33.0",
    "pusher": "^5.3.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stepci/runner": "^2.0.7",
    "@testcontainers/mysql": "11.13.0",
    "@testcontainers/redis": "11.13.0",
    "@types/big.js": "^7.0.0",
    "@types/lodash.camelcase": "4.3.9",
    "@types/lodash.has": "^4.5.9",
    "@types/lodash.head": "4.0.9",
    "@types/lodash.isempty": "4.4.9",
    "@types/lodash.isundefined": "^3.0.9",
    "@types/lodash.omitby": "^4.6.9",
    "@types/node": "20.11.17",
    "cac": "^6.7.14",
    "drizzle-kit": "0.31.9",
    "eslint": "10.0.3",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.6",
    "prettier": "3.8.1",
    "testcontainers": "11.14.0",
    "tsc-alias": "^1.9.4",
    "tsx": "4.7.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.57.1",
    "vitest": "4.1.0"
  }
}
