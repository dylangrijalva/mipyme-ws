ZERO_SHA="0000000000000000000000000000000000000000"
remote_name=$1
source_files_changed=false

while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    continue
  fi

  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    changed_files=$(git log --format= --name-only "$local_sha" --not "--remotes=$remote_name") || exit 1
  else
    changed_files=$(git log --format= --name-only "$remote_sha..$local_sha") || exit 1
  fi

  if printf '%s\n' "$changed_files" | grep -Eq '\.(ts|js|tsx|jsx)$'; then
    source_files_changed=true
  fi
done

if [ "$source_files_changed" = true ]; then
  pnpm test
fi
